@startuml 5_3_classes_sprint1
title Figure 5.3 — Diagramme de classes de conception, Sprint 1
skinparam classAttributeIconSize 0

class "settings" as Settings <<module config.settings>> {
  +LLM_MODEL : str = "qwen3:14b"
  +LLM_BASE_URL : str
  +EMBEDDING_MODEL : str = "bge-m3:latest"
  +EMBEDDING_BASE_URL : str
  +CHROMA_PATH : str
  +DOCS_COLLECTION_NAME : str = "odoo_docs"
  +RAG_CHUNK_SIZE : int = 512
  +RAG_CHUNK_OVERLAP : int = 50
  +ODOO_URL : str = "http://localhost:8069"
  +ODOO_DB : str
  +ODOO_ALLOWED_MODELS : frozenset
  +JWT_ALGORITHM : str = "HS256"
  +API_PORT : int = 8000
}

class "app" as FastAPIApp <<module api.main>> {
  +title : str = "MIRO AI API"
  +version : str = "1.0.0"
  +lifespan(app) : void
}

class OllamaEmbeddingFunction {
  +endpoint : str
  +model : str
  +api_key : str
  +timeout : float
  +max_retries : int
  +batch_size : int
  +name() : str
  -_embed_batch(texts : list[str]) : list[list[float]]
}

FastAPIApp ..> Settings : charge la configuration
OllamaEmbeddingFunction ..> Settings : initialisé selon
@enduml
