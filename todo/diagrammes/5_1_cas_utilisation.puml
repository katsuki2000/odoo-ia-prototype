@startuml 5_1_cas_utilisation
title Figure 5.1 — Diagramme de cas d'utilisation global du système
left to right direction
skinparam packageStyle rectangle

actor "Utilisateur Odoo\n(interne / client)" as U
actor "Administrateur" as A
actor "Odoo 17\n(ERP et sécurité)" as S <<Système>>

rectangle "Assistant IA MIRO — Odoo 17" {
  usecase "Poser une question\n(systray OWL)" as UC1
  usecase "S'authentifier sur Odoo 17" as UC2
  usecase "Fournir l'identité de session\n(uid, company_id, groupes)" as UC3
  usecase "Consulter l'historique\ndes conversations" as UC4
  usecase "Choisir le mode de source\n(Documentation / Système)" as UC5
  usecase "Visualiser la route,\nla confiance et les preuves" as UC6
  usecase "Consulter les sources\ndocumentaires (RAG hybride)" as UC7
  usecase "Interroger les données ERP\n(lecture seule, XML-RPC\nsous l'uid demandeur)" as UC8
  usecase "Appliquer les droits d'accès\n(ir.model.access et ir.rule)" as UC9
  usecase "Configurer les paramètres\n(miro.ai.settings)" as UC10
  usecase "Consulter le journal d'audit\n(miro.ai.log)" as UC11
  usecase "Gérer l'ingestion documentaire\n(API admin / CLI)" as UC12
}

U --> UC1
U --> UC4
A --> UC10
A --> UC11
A --> UC12
S --> UC3
S --> UC9

UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC1 ..> UC6 : <<include>>
UC5 .up.> UC1 : <<extend>>
UC7 .up.> UC1 : <<extend>>\n(route documentation)
UC8 .up.> UC1 : <<extend>>\n(route système)
UC8 ..> UC9 : <<include>>
@enduml
