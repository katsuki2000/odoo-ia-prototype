@startuml 5_9_classes_globale
set separator none
skinparam classAttributeIconSize 0
skinparam nodesep 15
skinparam ranksep 30
hide members

package "odoo_addons.miro_ai (Odoo 17)" {
  class MiroAiSystray <<Component OWL>> {
    +sendMessage() : void
    +askAndWait(payload) : Promise
  }
  class MiroAiController <<http.Controller>> {
    +ask(question, session_id, source_mode) : dict
    +ask_result(job_id, session_id) : dict
    +sessions(limit) : list
    +history(session_id) : list
  }
  class "ask_flow" as AskFlow <<module>> {
    +generate_jwt_token(payload, secret) : str
    +issue_requester_key(env, job_id) : str
    +revoke_requester_keys(env, job_id) : void
  }
  class "backend_client" as BackendClient <<module>> {
    +post_to_backend(...) : Response
    +get_from_backend(...) : Response
  }
  class MiroAiSettings <<models.Model>> {
    +api_url : Char
    +api_token : Char
    +request_timeout : Integer
    +get_signing_secret() : str
  }
  class MiroAiLog <<models.Model>> {
    +question : Text
    +answer : Text
    +session_id : Char
    +log_query(...) : record
  }
}

package "api (FastAPI)" {
  class "routes_ask" as RoutesAsk <<routeur>> {
    +POST /api/v1/ask
    +POST /api/v1/ask/jobs
    +GET /api/v1/ask/jobs/:job_id
  }
  class "auth" as Auth <<module>> {
    +verify_token(credentials) : dict
    +get_current_user(payload) : dict
    +require_admin(user) : dict
  }
  class AskJobStore {
    +submit(job_id, owner_uid, question, work) : void
    +get(job_id, owner_uid) : AskJob
  }
  class AskJob {
    +status() : str
    +elapsed_ms() : int
  }
}

package "core" {
  package "core.graph (orchestrateur)" {
    class "graph" as Graph <<module>> {
      +build_graph() : CompiledGraph
      +query_graph(question, uid, ...) : AssistantResponse
    }
    class "graph_nodes" as GraphNodes <<module>> {
      +retrieve(state) : dict
      +format_output(state) : dict
    }
    class "verify_node" as VerifyNode <<module>> {
      +verify_answer(state) : dict
    }
  }
  package "services partagés du noyau" {
    class "routing" as Routing <<core.routing>> {
      +route(state) : dict
      +route_decision(state) : str
    }
    class "source_selection" as SourceSelection <<core.source_selection>> {
      +select_source(question) : SourceSelection
    }
    class RAGState <<TypedDict>> {
      +question : str
      +uid : int | None
      +route : str | None
      +source_mode : str | None
      +retrieved_chunks : list[dict]
      +response : AssistantResponse | None
    }
    class AssistantResponse {
      +answer : str
      +sources : list[SourceReference]
      +confidence : float
      +route : str | None
      +verification : VerificationReport | None
      +evidence_dossier : list[Evidence]
    }
    class Evidence {
      +evidence_id : str
      +source_type : str
      +claim : str
      +value : Any
      +scope : dict
    }
    class "evidence" as EvidenceCollector <<core.evidence>> {
      +start_evidence_collection() : void
      +record_evidence(evidence) : void
      +peek_turn_evidence() : list
      +collect_and_clear_evidence() : list
    }
    class "session_store" as SessionStore <<core.session>> {
      +get_session(session_id, owner_uid) : list
      +update_session(session_id, chat_history, owner_uid) : void
    }
  }
}

package "document_rag" {
  class "search" as Search <<module>> {
    +retrieve(query, top_k) : list[dict]
  }
  class ChromaManager {
    +query(query_text, top_k, where) : dict
    +add_chunks(texts, metadatas, ids) : list[str]
  }
  class BM25Index {
    +build_from_chroma(manager) : void
    +search(query, top_k) : list[dict]
  }
  class "generate_node" as GenerateNode <<module>> {
    +generate(state) : dict
  }
  class "google_drive_sync" as DriveSync <<module>> {
    +synchronize_google_drive(client, folder_ids, manager) : dict
  }
}

package "erp_data" {
  class "orm_agent_node" as OrmAgentNode <<module>> {
    +orm_agent_loop(state) : dict
  }
  class QueryPlan {
    +subject : str
    +conditions : list[str]
    +result_kind : str
  }
  class "read_tools" as OrmRuntimeReadTools <<runtime>> {
    +orm_search_read(...) : OrmToolResult
    +orm_search_count(...) : OrmToolResult
    +orm_read_group(...) : OrmToolResult
  }
  class OrmToolResult {
    +observation : OrmObservation
    +evidence : list[Evidence]
    +text : str
  }
  class OdooConnector {
    +authenticate(username) : int
    +search_read(uid, model, ...) : list[dict]
  }
}

MiroAiSystray --> MiroAiController : RPC JSON
MiroAiController ..> AskFlow : JWT, clé éphémère
MiroAiController ..> BackendClient
MiroAiController ..> MiroAiSettings
MiroAiController ..> MiroAiLog
BackendClient ..> RoutesAsk : HTTP REST (JWT)
RoutesAsk ..> Auth
RoutesAsk --> AskJobStore : jobs
RoutesAsk ..> SessionStore : historique
AskJobStore "1" o-- "0..*" AskJob
AskJobStore ..> Graph : query_graph

Graph ..> RAGState
Graph ..> Routing : route,\nroute_decision
Graph ..> GraphNodes : retrieve,\nformat_output
Graph ..> VerifyNode : verify_answer
Graph ..> GenerateNode : generate
Graph ..> OrmAgentNode : orm_agent_loop
Graph ..> EvidenceCollector
Routing ..> SourceSelection
GraphNodes ..> Search : retrieve
VerifyNode ..> EvidenceCollector
AssistantResponse "1" o-- "0..*" Evidence : evidence_dossier

Search --> ChromaManager : dense
Search --> BM25Index : lexical
GenerateNode ..> AssistantResponse : produit
DriveSync --> ChromaManager

OrmAgentNode ..> QueryPlan
OrmAgentNode ..> EvidenceCollector
OrmAgentNode ..> AssistantResponse : produit
OrmAgentNode --> OrmRuntimeReadTools
OrmRuntimeReadTools ..> OrmToolResult
OrmToolResult ..> Evidence
OrmRuntimeReadTools --> OdooConnector
@enduml
