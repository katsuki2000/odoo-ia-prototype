@startuml 5_10_paquetage
skinparam packageStyle folder
left to right direction
skinparam nodesep 20
skinparam ranksep 45
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor #FFFFFF
}

package "odoo_addons.miro_ai\n(module Odoo 17)" as Addon {
  rectangle "controllers" as Ctrl
  rectangle "models" as Models
  rectangle "static.src (OWL)" as Owl
}

package "api\n(FastAPI)" as Api {
  rectangle "routes" as Routes
  rectangle "ask_jobs" as Jobs
  rectangle "auth (JWT)" as Auth
}

package "core\n(LangGraph)" as Core {
  rectangle "graph\n(orchestrateur)" as Graph
  rectangle "routing" as Routing
  rectangle "verification" as Verif
  rectangle "evidence" as Evid
  rectangle "llm" as Llm
  rectangle "session" as Sess
}

package "document_rag" as Rag {
  rectangle "ingestion" as Ingest
  rectangle "vectorstore" as Vec
}

package "erp_data" as Erp {
  rectangle "runtime" as Runtime
  rectangle "odoo_connector.py" as Conn
}

package "config" as Config {
}

rectangle "Serveur Odoo 17" as OdooServer

Addon ..> Api : HTTP REST (JWT)
Api ..> Core : exécute le graphe
Api ..> Rag : ingestion
Api ..> Conn : santé Odoo
Core <..> Rag : retrieve, generate /\nétat, LLM, preuves
Core <..> Erp : orm_agent_loop /\nétat, LLM, preuves
Conn ..> OdooServer : XML-RPC (uid demandeur)
Rag -[hidden]down-> Erp
Erp -[hidden]down-> Config
note bottom of Config : lue par api, core,\ndocument_rag, erp_data
@enduml
