@startuml 5_5_classes_sprint4
title Figure 5.5 — Diagramme de classes de conception, Sprint 4
skinparam classAttributeIconSize 0

class "search / search_hybrid" as Search <<module>> {
  +RAG_VECTOR_WEIGHT : float = 0.7
  +RAG_BM25_WEIGHT : float = 0.3
  +RAG_RELEVANCE_THRESHOLD : float = 0.01
  +RAG_TOP_K : int = 10
  +vector_search(chroma_manager, query, top_k) : list
  +hybrid_search(chroma_manager, bm25_index, query, ...) : list
  +retrieve(query, top_k, ...) : list[dict]
}

class "search_ranking" as Ranking <<module>> {
  +reciprocal_rank_fusion(...) : list
}

class ChromaManager {
  +query(query_text : str, top_k : int, where : dict) : dict
}

class BM25Index {
  +is_built() : bool
  +size() : int
  +build_from_chroma(chroma_manager) : void
  +search(query : str, top_k : int) : list[dict]
}

Search --> ChromaManager : recherche vectorielle dense
Search --> BM25Index : recherche lexicale exacte
Search ..> Ranking : fusion RRF
BM25Index ..> ChromaManager : s'alimente depuis
@enduml
