@startuml 5_2_modele_domaine
hide methods
skinparam classAttributeIconSize 0

package "Sphère applicative Odoo (modèles persistés)" {
  class Utilisateur <<res.users>> {
    id : int
    login : str
    name : str
  }
  class Societe <<res.company>> {
    id : int
    name : str
  }
  class ParametresMiroAI <<miro.ai.settings>> {
    name : str
    api_url : str
    api_token : str
    request_timeout : int
  }
  class JournalAudit <<miro.ai.log>> {
    question : str
    answer : str
    session_id : str
    response_time_ms : int
    sources_text : texte JSON
    sources_count : int
    metadata_text : texte JSON
    state : success / error
  }
  class SessionConversation <<dérivée>> {
    session_id : str
  }
}

package "Sphère d'orchestration IA (objets d'exécution, non persistés par Odoo)" {
  class ReponseAssistant <<AssistantResponse>> {
    answer : str
    confidence : float
    route : str
  }
  class SourceDocumentaire <<SourceReference>> {
    source : str
    title : str
    doc_type : str
    snippet : str
    page : int
  }
  class ObservationORM <<OrmObservation>> {
    tool : str
    model : str
    method : str
    row_count : int
    truncated : bool
    execution_identity : int
    read_at : str
  }
  class Preuve <<Evidence>> {
    evidence_id : str
    source_type : str
    claim : str
    value : Any
    source : str
    scope : dict
  }
  class RapportVerification <<VerificationReport>> {
    mode : off / report / enforce
    claims_total : int
    unsupported_claims : int
  }
}

Utilisateur "1..*" -- "1..*" Societe : rattaché à
Utilisateur "1" -- "0..*" JournalAudit : trace
Societe "1" -- "0..*" JournalAudit : cloisonne
SessionConversation "1" o-- "1..*" JournalAudit : regroupe\n(par session_id)
JournalAudit ..> ReponseAssistant : <<journalise>>\n(réponse, sources, route\net confiance en JSON)
ReponseAssistant "1" o-- "0..*" SourceDocumentaire : cite
ReponseAssistant "1" o-- "0..*" Preuve : s'appuie sur
ReponseAssistant "1" o-- "0..1" RapportVerification : évaluée par
ObservationORM "1" *-- "1..*" Preuve : produit

note bottom of SessionConversation
  Le fil de messages du LLM est conservé
  en mémoire par le backend, hors Odoo.
end note
@enduml
