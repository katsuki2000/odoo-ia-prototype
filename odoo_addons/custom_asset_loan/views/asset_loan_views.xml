<odoo>
    <record id="view_custom_asset_loan_form" model="ir.ui.view">
        <field name="name">custom.asset.loan.form</field>
        <field name="model">custom.asset.loan</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <field name="beneficiaire_id"/>
                <field name="materiel"/>
                <field name="demande_achat_liee_id"/>
                <field name="etat"/>
            </form>
        </field>
    </record>
    <record id="action_custom_asset_loan" model="ir.actions.act_window">
        <field name="name">Mises a disposition</field>
        <field name="res_model">custom.asset.loan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
