<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action serveur pour ouvrir le chat direct Discuss avec l'Assistant IA -->
    <record id="action_open_miro_discuss_chat" model="ir.actions.server">
        <field name="name">Chat Discuss (Assistant IA)</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_ai_chat()
        </field>
    </record>

    <!-- Entrée de menu directe dans l'application MIRO Assistant -->
    <menuitem id="menu_miro_ai_discuss_chat"
              name="Chat Discuss (Assistant IA)"
              parent="miro_ai.menu_miro_ai_root"
              action="action_open_miro_discuss_chat"
              sequence="15"
              groups="base.group_user"/>
</odoo>
