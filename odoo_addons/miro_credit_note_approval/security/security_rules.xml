<odoo>
    <record id="rule_avoir_visibilite_departement" model="ir.rule">
        <field name="name">Avoirs - visibilite par departement (sauf managers)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">['|', ('move_type', '!=', 'out_refund'), '|', ('invoice_user_id', '=', user.id), ('journal_id.department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
