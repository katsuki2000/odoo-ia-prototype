<odoo>
    <record id="view_custom_purchase_request_form" model="ir.ui.view">
        <field name="name">custom.purchase.request.form</field>
        <field name="model">custom.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <field name="demandeur_id"/>
                <field name="montant_estime"/>
                <field name="justification"/>
                <field name="etat"/>
            </form>
        </field>
    </record>
    <record id="action_custom_purchase_request" model="ir.actions.act_window">
        <field name="name">Demandes d'achat</field>
        <field name="res_model">custom.purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
