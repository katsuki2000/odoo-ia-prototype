<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data numstated="1">
        <!-- Rule 1: Global company rule -->
        <record id="rule_deep_document_company" model="ir.rule">
            <field name="name">Documents Profonds - Cantonnement Société</field>
            <field name="model_id" ref="model_custom_deep_document"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]</field>
        </record>

        <!-- Rule 2: Complex nested domain force with AND/OR -->
        <record id="rule_deep_document_complex_nested" model="ir.rule">
            <field name="name">Documents Profonds - Règle Imbriquée Complexe</field>
            <field name="model_id" ref="model_custom_deep_document"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['&amp;', '|', ('amount', '&lt;=', 50000), ('user_id', '=', user.id), ('company_id', '=', user.company_id.id)]</field>
        </record>
    </data>
</odoo>
