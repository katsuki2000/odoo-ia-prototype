<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List (tree) view of the MIRO AI audit log -->
    <record id="view_miro_ai_log_tree" model="ir.ui.view">
        <field name="name">miro.ai.log.tree</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <tree string="MIRO AI Request Log" create="false" edit="false" delete="false" decoration-danger="state == 'error'" decoration-info="state == 'success'">
                <field name="create_date" string="Date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="question"/>
                <field name="response_time_ms" string="Duration (ms)"/>
                <field name="sources_count" string="Sources"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Form view of the MIRO AI audit log -->
    <record id="view_miro_ai_log_form" model="ir.ui.view">
        <field name="name">miro.ai.log.form</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <form string="MIRO AI Request Detail" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="create_date"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="response_time_ms"/>
                            <field name="sources_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question &amp; Answer">
                            <group string="Question asked">
                                <field name="question" nolabel="1"/>
                            </group>
                            <group string="AI answer (HTML / formatted)">
                                <field name="answer" widget="html" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Sources &amp; JSON metadata">
                            <field name="sources_text" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view of the audit log -->
    <record id="view_miro_ai_log_search" model="ir.ui.view">
        <field name="name">miro.ai.log.search</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <search string="Search the MIRO AI Log">
                <field name="question" string="Question / Answer" filter_domain="['|', ('question', 'ilike', self), ('answer', 'ilike', self)]"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <filter string="Success" name="filter_success" domain="[('state', '=', 'success')]"/>
                <filter string="Errors" name="filter_error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('create_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group by">
                    <filter string="User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action opening the audit log -->
    <record id="action_miro_ai_log" model="ir.actions.act_window">
        <field name="name">AI Request Log</field>
        <field name="res_model">miro.ai.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_miro_ai_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No RAG request recorded in the log yet.
            </p>
            <p>
                Ask a question from the MIRO AI assistant to see the history and audit metrics appear here.
            </p>
        </field>
    </record>
</odoo>
