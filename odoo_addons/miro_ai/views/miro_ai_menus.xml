<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MIRO AI main menu -->
    <menuitem id="menu_miro_ai_root"
              name="MIRO Assistant"
              sequence="50"
              web_icon="miro_ai,static/description/icon.png"
              groups="base.group_user"/>

    <!-- AI request log sub-menu -->
    <menuitem id="menu_miro_ai_log"
              name="Request Log"
              parent="menu_miro_ai_root"
              action="action_miro_ai_log"
              sequence="20"
              groups="base.group_user"/>


    <!-- Configuration sub-menu -->
    <menuitem id="menu_miro_ai_config"
              name="Configuration"
              parent="menu_miro_ai_root"
              sequence="100"
              groups="base.group_system,miro_ai.group_miro_ai_admin"/>

    <!-- Settings entry under Configuration -->
    <menuitem id="menu_miro_ai_settings_action"
              name="Settings"
              parent="menu_miro_ai_config"
              action="action_miro_ai_settings"
              sequence="10"/>
</odoo>
