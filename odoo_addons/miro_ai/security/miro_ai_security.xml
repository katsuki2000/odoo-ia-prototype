<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie pour MIRO AI -->
        <record id="module_category_miro_ai" model="ir.module.category">
            <field name="name">MIRO Assistant IA</field>
            <field name="description">Gestion des accès à l'assistant MIRO IA</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groupe Utilisateur MIRO AI -->
        <record id="group_miro_ai_user" model="res.groups">
            <field name="name">Utilisateur MIRO AI</field>
            <field name="category_id" ref="module_category_miro_ai"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut interroger l'assistant MIRO et voir ses historiques.</field>
        </record>

        <!-- Groupe Administrateur MIRO AI -->
        <record id="group_miro_ai_admin" model="res.groups">
            <field name="name">Administrateur MIRO AI</field>
            <field name="category_id" ref="module_category_miro_ai"/>
            <field name="implied_ids" eval="[(4, ref('group_miro_ai_user'))]"/>
            <field name="comment">Peut configurer l'API, les compétences et consulter tous les journaux.</field>
        </record>

        <!-- Règle multi-sociétés pour les paramètres MIRO AI -->
        <record id="rule_miro_ai_settings_company" model="ir.rule">
            <field name="name">MIRO AI Settings Multi-Company</field>
            <field name="model_id" ref="model_miro_ai_settings"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Règle de visibilité du journal : Utilisateur voit ses propres requêtes de sa société -->
        <record id="rule_miro_ai_log_user" model="ir.rule">
            <field name="name">MIRO AI Log : Voir ses requêtes</field>
            <field name="model_id" ref="model_miro_ai_log"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['&amp;', ('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Règle de visibilité du journal : Admin voit toutes les requêtes des sociétés autorisées -->
        <record id="rule_miro_ai_log_admin" model="ir.rule">
            <field name="name">MIRO AI Log : Admin voit tout</field>
            <field name="model_id" ref="model_miro_ai_log"/>
            <field name="groups" eval="[(4, ref('group_miro_ai_admin')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
