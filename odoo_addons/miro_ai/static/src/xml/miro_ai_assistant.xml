<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===================================================================== -->
    <!-- Navbar Systray Toggle & Floating Drawer Template                      -->
    <!-- ===================================================================== -->
    <t t-name="miro_ai.SystrayItem">
        <div class="o_nav_entry miro-systray-container d-flex align-items-center">
            <!-- Systray Navbar Button -->
            <a class="miro-systray-btn d-flex align-items-center px-2 py-1 text-decoration-none" role="button" t-on-click="toggleDrawer" title="MIRO AI Assistant">
                <span class="badge bg-primary text-white font-weight-bold px-2 py-1 miro-systray-label" style="font-size: 0.75rem; border-radius: 4px;">MIRO AI</span>
            </a>

            <!-- Floating Side Drawer Panel -->
            <div t-if="state.isOpen" class="miro-ai-drawer shadow-lg">
                <div class="miro-drawer-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <strong class="miro-drawer-title text-dark">MIRO AI Assistant</strong>
                    </div>
                    <div class="d-flex align-items-center">
                        <button class="btn btn-sm btn-link text-muted p-0 mr-2" t-on-click="startNewConversation" title="New conversation">
                            <i class="fa fa-plus"/>
                        </button>
                        <button class="btn btn-sm btn-link text-muted p-0 mr-2" t-on-click="toggleHistory" title="History">
                            <i class="fa fa-history"/>
                        </button>
                        <button class="btn btn-sm btn-link text-muted p-0" t-on-click="closeDrawer" title="Close">
                            <i class="fa fa-times fa-lg"/>
                        </button>
                    </div>
                </div>

                <!-- Compact History List -->
                <div t-if="state.showHistory" class="miro-drawer-history p-2">
                    <div t-if="state.loadingSessions" class="text-muted text-center p-3 small">
                        <i class="fa fa-spinner fa-spin mr-1"/> Loading...
                    </div>
                    <div t-elif="state.sessions.length === 0" class="text-muted text-center p-3 small">
                        No conversation recorded.
                    </div>
                    <t t-else="">
                        <div t-foreach="state.sessions" t-as="session" t-key="session.session_id"
                             class="miro-history-item" t-on-click="() => this.loadSession(session.session_id)">
                            <div class="miro-history-item-preview small" t-esc="session.preview"/>
                            <div class="miro-history-item-meta text-muted small">
                                <span t-esc="formatSessionDate(session.last_activity)"/>
                                <span class="mx-1">·</span>
                                <span t-esc="getExchangeCountLabel(session.message_count)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Drawer Messages Container -->
                <div t-if="!state.showHistory" class="miro-drawer-messages p-3" t-ref="drawerMessages">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                        <div t-att-class="'miro-ai-message miro-drawer-message ' + (msg.sender === 'user' ? 'user-message' : 'bot-message') + (msg.cancelled ? ' cancelled-message' : '')">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="message-sender" t-esc="getSenderLabel(msg)"/>
                                <t t-if="msg.sender === 'bot' and msg.route">
                                    <span t-att-class="'badge badge-xs ' + getRouteBadgeClass(msg.route)" t-esc="getRouteLabel(msg.route)"/>
                                </t>
                            </div>
                            <div class="message-content small" t-out="msg.formattedContent or msg.content"/>

                            <!-- Foldable Verification Details in Drawer -->
                            <t t-if="msg.sender === 'bot' and msg.sources and msg.sources.length > 0">
                                <details class="miro-verification-disclosure mt-2 small">
                                    <summary class="verification-summary small">
                                        <i class="fa fa-chevron-right mr-1 verification-chevron"/>
                                        <i class="fa fa-search mr-1 text-primary"/> <t t-esc="getEvidenceLabel(msg.sources ? msg.sources.length : 0)"/>
                                    </summary>
                                    <div class="verification-content p-2 mt-1 bg-white rounded border">
                                        <t t-if="msg.sources and msg.sources.length > 0">
                                            <div class="text-success font-weight-bold mb-1">Sources:</div>
                                            <ul class="pl-3 mb-0 small text-muted">
                                                <t t-foreach="msg.sources" t-as="s" t-key="s_index">
                                                    <li class="mb-2">
                                                        <a t-if="s.source and (s.source.startsWith('https://') or s.source.startsWith('http://'))"
                                                           t-att-href="s.source" target="_blank" rel="noopener noreferrer"><strong t-esc="s.title or s.source"/></a>
                                                        <strong t-else="" t-esc="s.title or s.source"/>
                                                        <t t-if="s.snippet">
                                                            <pre class="source-snippet p-2 mt-1 rounded bg-light text-dark"><t t-esc="s.snippet"/></pre>
                                                        </t>
                                                    </li>
                                                </t>
                                            </ul>
                                        </t>
                                    </div>
                                </details>
                            </t>
                        </div>
                    </t>

                    <div t-if="state.loading" class="miro-ai-message bot-message loading-indicator small">
                        <i class="fa fa-spinner fa-spin mr-1"/> <span>Analysis in progress...</span>
                    </div>
                </div>

                <!-- Drawer Input Area -->
                <div t-if="!state.showHistory" class="miro-drawer-input p-2 border-top bg-white">
                    <div class="miro-source-toggle mb-1">
                        <button type="button" t-attf-class="btn btn-sm miro-source-btn #{state.sourceMode === 'documentation' ? 'active' : ''}"
                                t-on-click="() => this.toggleSourceMode('documentation')"
                                title="Answer only from the internal documentation">
                            <i class="fa fa-book"/> From the documentation
                        </button>
                        <button type="button" t-attf-class="btn btn-sm miro-source-btn #{state.sourceMode === 'system' ? 'active' : ''}"
                                t-on-click="() => this.toggleSourceMode('system')"
                                title="Answer from the system's data and code">
                            <i class="fa fa-cogs"/> From the system
                        </button>
                    </div>
                    <div class="d-flex align-items-center">
                        <input type="text" class="form-control form-control-sm miro-drawer-input-field me-2" placeholder="Ask a question..."
                               t-model="state.inputQuestion" t-on-keydown="onKeyDown"/>
                        <button t-if="!state.loading" class="btn btn-primary miro-drawer-send-btn" type="button" t-on-click="sendMessage">
                            <i class="fa fa-paper-plane"/>
                        </button>
                        <button t-else="" class="btn miro-stop-btn miro-drawer-send-btn" type="button" t-on-click="cancelRequest" title="Cancel the current question">
                            <i class="fa fa-stop"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
