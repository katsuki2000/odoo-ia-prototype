<odoo>
    <record id="rule_avoir_multi_societe" model="ir.rule">
        <field name="name">Avoirs - cantonnement societe (regle globale, sans groupe)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">['|', ('move_type', '!=', 'out_refund'), ('company_id', '=', user.company_id.id)]</field>
    </record>

    <record id="rule_avoir_visibilite_regionale" model="ir.rule">
        <field name="name">Avoirs - plafond visibilite regionale (50000e)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">['|', ('move_type', '!=', 'out_refund'), ('amount_total', '&lt;=', 50000)]</field>
        <field name="groups" eval="[(4, ref('group_avoir_regional'))]"/>
    </record>

    <record id="rule_avoir_visibilite_nationale" model="ir.rule">
        <field name="name">Avoirs - visibilite nationale (illimitee)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_avoir_national'))]"/>
    </record>
</odoo>
