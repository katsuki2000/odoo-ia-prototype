<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Account Entry">
                <header>
                    <button name="action_post" string="Post" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="button_cancel" string="Cancel Entry" type="object" invisible="state == 'cancel'"/>
                    <widget name="account_move_widget"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group id="header_left_group">
                            <field name="partner_id" widget="res_partner_many2one"/>
                            <field name="date"/>
                        </group>
                        <group id="header_right_group">
                            <field name="journal_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page id="aml_tab" string="Journal Items">
                            <field name="line_ids" context="{'default_move_type': context.get('default_move_type')}">
                                <tree editable="bottom" string="Journal Items">
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
