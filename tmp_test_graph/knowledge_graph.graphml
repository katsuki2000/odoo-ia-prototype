    <node id="server_action:custom_automation_traps.ir_action_server_avoir_fournisseur_privilegie">
      <data key="d0">ServerAction</data>
      <data key="d17">custom_automation_traps.ir_action_server_avoir_fournisseur_privilegie</data>
      <data key="d1">Auto-validation avoirs fournisseurs privilegies (logique cachee)</data>
      <data key="d25">account.model_account_move</data>
      <data key="d26">code</data>
      <data key="d27">
# Regle non documentee ailleurs : les avoirs recus de 3 fournisseurs
# identifies par ID en dur sont automatiquement valides, sans passer
# par AUCUNE des verifications d'approbation des autres modules,
# via sudo() qui contourne tous les droits d'ecriture.
FOURNISSEURS_PRIVILEGIES = [42, 108, 231]
for rec in records:
    if rec.move_type == 'in_refund' and rec.partner_id.id in FOURNISSEURS_PRIVILEGIES:
        rec.sudo().action_post()
        </data>
    </node>
    <node id="server_action:ir_action_server_avoir_fournisseur_privilegie">
      <data key="d0">ServerAction</data>
      <data key="d17">ir_action_server_avoir_fournisseur_privilegie</data>
      <data key="d1">Auto-validation avoirs fournisseurs privilegies (logique cachee)</data>
      <data key="d25">account.model_account_move</data>
      <data key="d26">code</data>
      <data key="d27">
# Regle non documentee ailleurs : les avoirs recus de 3 fournisseurs
# identifies par ID en dur sont automatiquement valides, sans passer
# par AUCUNE des verifications d'approbation des autres modules,
# via sudo() qui contourne tous les droits d'ecriture.
FOURNISSEURS_PRIVILEGIES = [42, 108, 231]
for rec in records:
    if rec.move_type == 'in_refund' and rec.partner_id.id in FOURNISSEURS_PRIVILEGIES:
        rec.sudo().action_post()
        </data>
    </node>
