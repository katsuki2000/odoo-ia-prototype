# Copy to .env (ignored by git). The .env holds ONLY what changes from one machine or deployment to another:
# secrets, connection addresses, Odoo installation locations (portable default);
# everything else is a constant of config/settings.py (or config/google_drive.py; the allowed Odoo models list, ODOO_ALLOWED_MODELS, is also set there).

# ── Secrets ───────────────────────────────────────────────────────────────────
# JWT signing secret (required, >= 32 bytes). Must match the api_token field of the
# MIRO AI settings in Odoo. Generate one with, for example:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Odoo service account password: REQUIRED, no default. Never in the Odoo UI.
ODOO_ADMIN_PASSWORD=
# Odoo service account login (default: admin).
# ODOO_ADMIN_LOGIN=
# Password of the Odoo account used by the benchmarks and manual checks (scripts/run_erp_model_eval.py,
# scripts/run_doc_nonregression.py, scripts/manual_check_odoo_assistant.py); not needed by the backend.
# ODOO_BENCH_PASSWORD=
# API key of the inference server, only if it requires one (Ollama: none).
# LLM_API_KEY=
# EMBEDDING_API_KEY=

# ── LLM / embeddings server: target and address ───────────────────────────────
# LLM_TARGET selects the inference host: aws (default, production) or kaggle (temporary dev).
# The aws target reads the unprefixed variables; kaggle reads the KAGGLE_* variables. No implicit server.
OLLAMA_HOST=http://<aws-instance-address>:11434

# Kaggle (temporary): to remove it, delete this block and the 'kaggle' entry of LLM_TARGETS
# in config/settings.py.
# LLM_TARGET=kaggle
# KAGGLE_OLLAMA_HOST=https://<ngrok-tunnel>

# ── Optional addresses (defaults in config/settings.py) ───────────────────────
# HTTP bind address of the API. Default: 127.0.0.1. Use 0.0.0.0 only in a container or behind a
# trusted reverse proxy.
# API_HOST=127.0.0.1
# Allowed CORS origins (CSV). Empty = no browser origin (default). The Odoo addons
# call the API server-side; leave empty unless a UI needs it.
# CORS_ALLOWED_ORIGINS=
# Odoo database for calls outside a user request (health, evaluation scripts): no default.
# A user request only uses the database signed in its JWT.
# ODOO_DB=
# Models, paths, budgets, ORM limits, Google Drive limits: constants of config/settings.py and
# config/google_drive.py (variable table in the README).
# Google Drive: shared RAG corpus (see the README, Step 9)
# GOOGLE_DRIVE_FOLDER_IDS=
# GOOGLE_APPLICATION_CREDENTIALS=secrets/miro-drive-reader.json
# GOOGLE_DRIVE_APPROVED_FOR_RAG=false

# Write captures/reasoning_trace.jsonl (question preview, tool arguments, result excerpts); leave unset in production.
# REASONING_TRACE_ENABLED=true
