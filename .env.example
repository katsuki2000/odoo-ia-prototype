# Copy to .env (ignored by git). The .env holds ONLY what changes from one machine or deployment to another:
# secrets, connection addresses and locations of external installs.
# Everything else is a constant of config/settings.py or config/google_drive.py (variable table in the README).
# Variables commented out show their default; REQUIRED ones have none.

# -- Secrets ------------------------------------------------------------------
# JWT signing secret, REQUIRED, at least 32 bytes. Must match the api_token field of the MIRO AI
# settings in Odoo. Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Password of the Odoo service account, REQUIRED. Never set it in the Odoo interface.
ODOO_ADMIN_PASSWORD=

# -- Inference server (LLM and embeddings) ------------------------------------
# Address of the Ollama server (chat and embeddings), REQUIRED. No implicit server; the only value to change to move it.
OLLAMA_HOST=http://<aws-instance-address>:11434

# -- Odoo instance ------------------------------------------------------------
# XML-RPC address of the instance.
# ODOO_URL=http://localhost:8069
# Service account login.
# ODOO_ADMIN_LOGIN=admin
# Database for calls outside a user request (health check, scripts); no default.
# A user request only uses the database signed in its JWT.
# ODOO_DB=
# Odoo source checkout: the answer verifier reads the native ORM method names from odoo/models.py.
# ODOO_SOURCE_PATH=../odoo-17.0

# -- API server ---------------------------------------------------------------
# Bind address. Use 0.0.0.0 only in a container or behind a trusted reverse proxy.
# API_HOST=127.0.0.1
# API_PORT=8000
# Allowed CORS origins (CSV). Empty: no browser origin. The Odoo addon calls the API server-side.
# CORS_ALLOWED_ORIGINS=

# -- Google Drive corpus (see the README, Step 9) -----------------------------
# Comma-separated IDs of the approved folders; empty: the synchronization does nothing.
# GOOGLE_DRIVE_FOLDER_IDS=
# Must be true: confirms that every RAG reader may see the selected folders.
# GOOGLE_DRIVE_APPROVED_FOR_RAG=false
# Read-only service account file, read by the Google client library.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/miro-drive-reader.json

# -- Diagnostics --------------------------------------------------------------
# captures/reasoning_trace.jsonl (question preview, tool arguments, result excerpts) is written by default; set to false to stop it.
# REASONING_TRACE_ENABLED=false

# -- Benchmarks and manual checks only (never read by the backend) ------------
# Password of the Odoo user the benchmarks and scripts/manual_check_odoo_assistant.py sign in as.
# ODOO_BENCH_PASSWORD=
