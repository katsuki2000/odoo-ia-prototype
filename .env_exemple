# ══════════════════════════════════════════════════════════════════════════════
# Configuration Environnement - Odoo IA Prototype
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Fournisseur LLM Actif ──────────────────────────────────────────────────
# Options : 'local' (Ollama / vLLM / llama.cpp) ou 'groq' (Cloud)
# Pour basculer en 100% local, changez simplement cette variable :
LLM_PROVIDER=groq

# ── 2. Configuration LLM Local (Ollama, vLLM, LM Studio, llama.cpp) ───────────
# Actif dès que LLM_PROVIDER=local. Aucun appel externe n'est émis.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_API_KEY=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# ── 3. Configuration Cloud LLM (Groq / OpenRouter) ────────────────────────────
# Actif si LLM_PROVIDER=groq ou LLM_PROVIDER=openrouter
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_API_KEYS=

OPENROUTER_API_KEY=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
OPENROUTER_MODEL=qwen/qwen3-14b:free

# ── 4. Configuration Embeddings (RAG Documentaire) ────────────────────────────
# Options : 'local_light' (ONNX all-MiniLM-L6-v2 intégré, 100% CPU local, recommandé)
#           'local_server' (Ollama embedding local via LOCAL_EMBEDDING_BASE_URL)
EMBEDDING_BACKEND=local_light
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
LOCAL_EMBEDDING_MODEL=all-minilm:latest
LOCAL_EMBEDDING_API_KEY=ollama


# ── 5. Chemins du Corpus Odoo & Documents ─────────────────────────────────────
CORE_ADDONS_PATH=/odoo-17.0/addons
CUSTOM_ADDONS_PATH=/odoo-ia-prototype/odoo_addons
RAG_DOCS_PATH=/odoo-ia-prototype/document_rag/documents

# ── 6. Connexion Instance Odoo (Runtime XML-RPC) ──────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=
ODOO_ADMIN_PASSWORD=a