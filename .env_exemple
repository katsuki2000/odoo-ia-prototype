# LLM Provider: 'groq' (default), 'local' (Ollama / vLLM / openai_compatible), or 'openrouter'
LLM_PROVIDER=groq

# Groq Cloud configuration
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b

# Local LLM configuration (Ollama, vLLM, llama.cpp, LM Studio, LocalAI)
# When LLM_PROVIDER=local, no Groq key is needed.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_API_KEY=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# OpenRouter configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-14b:free

# Addons paths
CORE_ADDONS_PATH=
CUSTOM_ADDONS_PATH=

# ── Embeddings configuration ───────────────────────────
# EMBEDDING_BACKEND options:
# - 'local_light' (default): ChromaDB built-in ONNX all-MiniLM-L6-v2 (384 dims) -- recommended for machines without AVX/AVX2.
# - 'local_server' / 'ollama' / 'openai_compatible': Offloads embeddings over HTTP to a local server (Ollama, TEI, LocalAI).
# - 'nomic_api': Calls cloud Nomic Atlas REST API (requires NOMIC_API_KEY).
# - 'local': Local PyTorch nomic-embed-text-v1.5 (requires modern CPU with AVX2).
EMBEDDING_BACKEND=local_light
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
LOCAL_EMBEDDING_MODEL=all-minilm:latest
LOCAL_EMBEDDING_API_KEY=ollama