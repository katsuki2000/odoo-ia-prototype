<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste (Tree) pour le Journal d'audit MIRO AI -->
    <record id="view_miro_ai_log_tree" model="ir.ui.view">
        <field name="name">miro.ai.log.tree</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <tree string="Journal des requêtes MIRO AI" create="false" edit="false" delete="false" decoration-danger="state == 'error'" decoration-info="state == 'success'">
                <field name="create_date" string="Date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="question"/>
                <field name="response_time_ms" string="Durée (ms)"/>
                <field name="sources_count" string="Sources"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire (Form) pour le Journal d'audit MIRO AI -->
    <record id="view_miro_ai_log_form" model="ir.ui.view">
        <field name="name">miro.ai.log.form</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <form string="Détail de la requête MIRO AI" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="create_date"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="response_time_ms"/>
                            <field name="sources_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question &amp; Réponse">
                            <group string="Question posée">
                                <field name="question" nolabel="1"/>
                            </group>
                            <group string="Réponse de l'IA (HTML / Formatté)">
                                <field name="answer" widget="html" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Sources &amp; Métadonnées JSON">
                            <field name="sources_text" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Recherche (Search) pour le Journal d'audit -->
    <record id="view_miro_ai_log_search" model="ir.ui.view">
        <field name="name">miro.ai.log.search</field>
        <field name="model">miro.ai.log</field>
        <field name="arch" type="xml">
            <search string="Rechercher dans le Journal MIRO AI">
                <field name="question" string="Question / Réponse" filter_domain="['|', ('question', 'ilike', self), ('answer', 'ilike', self)]"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <filter string="Succès" name="filter_success" domain="[('state', '=', 'success')]"/>
                <filter string="Erreurs" name="filter_error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="filter_today" domain="[('create_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Utilisateur" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Statut" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Société" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action pour ouvrir le Journal d'audit -->
    <record id="action_miro_ai_log" model="ir.actions.act_window">
        <field name="name">Journal des requêtes IA</field>
        <field name="res_model">miro.ai.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_miro_ai_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune requête RAG enregistrée dans le journal.
            </p>
            <p>
                Posez une question depuis l'interface "Discussion Assistant" pour voir apparaître l'historique et les métriques d'audit ici.
            </p>
        </field>
    </record>
</odoo>
