<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie pour MIRO AI -->
        <record id="module_category_miro_ai" model="ir.module.category">
            <field name="name">MIRO Assistant IA</field>
            <field name="description">Gestion des accès à l'assistant MIRO IA</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groupe Utilisateur MIRO AI -->
        <record id="group_miro_ai_user" model="res.groups">
            <field name="name">Utilisateur MIRO AI</field>
            <field name="category_id" ref="module_category_miro_ai"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut interroger l'assistant MIRO et voir ses historiques.</field>
        </record>

        <!-- Groupe Administrateur MIRO AI -->
        <record id="group_miro_ai_admin" model="res.groups">
            <field name="name">Administrateur MIRO AI</field>
            <field name="category_id" ref="module_category_miro_ai"/>
            <field name="implied_ids" eval="[(4, ref('group_miro_ai_user'))]"/>
            <field name="comment">Peut configurer l'API, les compétences et consulter tous les journaux.</field>
        </record>
    </data>
</odoo>
