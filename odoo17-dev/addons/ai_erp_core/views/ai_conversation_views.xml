<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- ai.conversation + ai.message views                                 -->
    <!-- ai.tool views                                                      -->
    <!-- ================================================================= -->

    <!-- ── ai.conversation ─────────────────────────────────────────────── -->

    <record id="view_ai_conversation_form" model="ir.ui.view">
        <field name="name">ai.conversation.form</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation IA">
                <header>
                    <button
                        name="action_clear"
                        string="Effacer l'historique"
                        type="object"
                        class="btn-danger"
                        confirm="Supprimer tous les messages de cette conversation ?"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="config_id" readonly="1"/>
                        <field name="message_count" readonly="1"/>
                    </group>

                    <!-- Chat widget placeholder — replaced by JS widget -->
                    <div id="ai_chat_container" class="ai-chat-container">
                        <field name="message_ids" widget="ai_chat_messages" nolabel="1"/>
                    </div>

                    <!-- Fallback form view of messages -->
                    <field name="message_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="role" widget="badge"
                                   decoration-info="role == 'user'"
                                   decoration-success="role == 'assistant'"/>
                            <field name="content"/>
                            <field name="pipeline_used" optional="show"/>
                            <field name="citations_display" optional="hide"/>
                            <field name="duration_ms" string="ms" optional="show"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_conversation_list" model="ir.ui.view">
        <field name="name">ai.conversation.list</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <tree string="Conversations">
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="create_date"/>
                <button name="action_open_chat" string="Ouvrir" type="object"/>
            </tree>
        </field>
    </record>

    <!-- My conversations (current user only) -->
    <record id="action_ai_conversation_my" model="ir.actions.act_window">
        <field name="name">Assistant IA</field>
        <field name="res_model">ai.conversation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <!-- All conversations (admin) -->
    <record id="action_ai_conversation_all" model="ir.actions.act_window">
        <field name="name">Toutes les conversations</field>
        <field name="res_model">ai.conversation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── ai.tool ──────────────────────────────────────────────────────── -->

    <record id="view_ai_tool_form" model="ir.ui.view">
        <field name="name">ai.tool.form</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <form string="Outil ORM">
                <header>
                    <button
                        name="action_reset_stats"
                        string="Réinitialiser les statistiques"
                        type="object"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" placeholder="Nom affiché"/>
                        </h1>
                        <h2>
                            <field name="tool_name" placeholder="nom_de_la_fonction"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group string="Statistiques d'utilisation">
                            <field name="call_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                            <field name="last_called" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description (vue par le LLM)">
                        <field name="description" widget="text" nolabel="1"/>
                    </group>
                    <group string="Schéma des paramètres (JSON)">
                        <field name="parameters_schema" widget="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_tool_list" model="ir.ui.view">
        <field name="name">ai.tool.list</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <tree string="Outils ORM">
                <field name="display_name"/>
                <field name="tool_name"/>
                <field name="category" widget="badge"/>
                <field name="call_count"/>
                <field name="error_count" optional="show"/>
                <field name="last_called" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_ai_tool" model="ir.actions.act_window">
        <field name="name">Outils ORM</field>
        <field name="res_model">ai.tool</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
