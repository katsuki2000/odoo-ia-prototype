<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- ai.config — Form & List views                                      -->
    <!-- ================================================================= -->

    <record id="view_ai_config_form" model="ir.ui.view">
        <field name="name">ai.config.form</field>
        <field name="model">ai.config</field>
        <field name="arch" type="xml">
            <form string="Configuration IA">
                <header>
                    <button
                        name="action_test_connection"
                        string="Tester la connexion Ollama"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_list_models"
                        string="Lister les modèles disponibles"
                        type="object"
                        class="btn-secondary"
                    />
                    <field name="last_test_result" widget="statusbar"
                           statusbar_visible="pending,ok,error"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la configuration"/></h1>
                    </div>

                    <group>
                        <group string="Général">
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Dernier test">
                            <field name="last_test_date"/>
                            <field name="last_test_message"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Ollama ── -->
                        <page string="Ollama / LLM" name="ollama">
                            <group>
                                <group string="Connexion">
                                    <field name="ollama_base_url"/>
                                    <field name="timeout_seconds"/>
                                </group>
                                <group string="Modèles">
                                    <field name="model_chat"/>
                                    <field name="model_embed"/>
                                </group>
                            </group>
                            <group>
                                <group string="Paramètres de génération">
                                    <field name="temperature" widget="float"/>
                                    <field name="max_tokens"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── ChromaDB ── -->
                        <page string="ChromaDB" name="chromadb">
                            <group>
                                <group string="Connexion">
                                    <field name="chromadb_host"/>
                                    <field name="chromadb_port"/>
                                </group>
                                <group string="Collections">
                                    <field name="chromadb_collection_docs"/>
                                    <field name="chromadb_collection_code"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── RAG ── -->
                        <page string="RAG &amp; Ingestion" name="rag">
                            <group>
                                <group string="Paramètres RAG">
                                    <field name="rag_top_k"/>
                                    <field name="chunk_size"/>
                                    <field name="chunk_overlap"/>
                                </group>
                                <group string="Code source">
                                    <field name="code_ingestion_paths" widget="text"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Prompt ── -->
                        <page string="Prompt système" name="prompt">
                            <field name="system_prompt" widget="text"
                                   placeholder="Instructions données au modèle LLM..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_config_list" model="ir.ui.view">
        <field name="name">ai.config.list</field>
        <field name="model">ai.config</field>
        <field name="arch" type="xml">
            <tree string="Configurations IA">
                <field name="name"/>
                <field name="ollama_base_url"/>
                <field name="model_chat"/>
                <field name="company_id"/>
                <field name="last_test_result" widget="badge"
                       decoration-success="last_test_result == 'ok'"
                       decoration-danger="last_test_result == 'error'"
                       decoration-warning="last_test_result == 'pending'"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_ai_config" model="ir.actions.act_window">
        <field name="name">Paramètres IA</field>
        <field name="res_model">ai.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
