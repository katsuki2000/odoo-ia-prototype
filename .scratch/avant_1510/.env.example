# ── 1. Fournisseur LLM Actif ──────────────────────────────────────────────────
# Fournisseur local compatible OpenAI : Ollama, vLLM, llama.cpp ou LM Studio.
LLM_PROVIDER=local

# ── 2. Isolement Local & Sécurité Réseau ──────────────────────────────────────
# Bloque les fournisseurs cloud et les requêtes hors des hôtes autorisés.
# Garder actif pour limiter l'inférence aux hôtes locaux autorisés.
LOCAL_ONLY=true
LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Secret de signature JWT (obligatoire, >= 32 octets). Doit etre identique au
# champ api_token des parametres MIRO AI dans Odoo. Generer par exemple :
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# Bind HTTP de l'API. Defaut code : 127.0.0.1. Mettre 0.0.0.0 seulement en
# conteneur ou derriere un reverse-proxy de confiance.
API_HOST=127.0.0.1

# Origines CORS autorisees (CSV). Vide = aucune origine navigateur (defaut).
# Les addons Odoo appellent l'API cote serveur ; laisser vide sauf besoin UI.
CORS_ALLOWED_ORIGINS=

# ── 3. Configuration LLM Local (Ollama, vLLM, LM Studio, llama.cpp) ───────────
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_API_KEY=ollama
# Soft switch skipping the reasoning phase on short structured calls; defaults to /no_think for Qwen3 models, empty otherwise.
# LLM_NO_THINK_MARKER=/no_think
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# ── 5. Configuration Embeddings (RAG Documentaire) ────────────────────────────
# Defaut : 'local_server' (serveur d'inference OpenAI-compatible : Ollama/vLLM en local, ou distant sur Kaggle/AWS,
#          via LOCAL_EMBEDDING_BASE_URL ; le modele doit y etre present : `ollama pull bge-m3`).
# Un serveur distant doit etre autorise : LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1,<hote-du-serveur>
# Alternative : 'local_light' (ONNX all-MiniLM-L6-v2 integre, CPU local, sans serveur ; collections Chroma non
#               compatibles avec bge-m3 : reindexer en cas de changement).
EMBEDDING_BACKEND=local_server
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
LOCAL_EMBEDDING_MODEL=bge-m3:latest
LOCAL_EMBEDDING_API_KEY=ollama
# Delai maximal (secondes) d'un appel d'embedding local.
LOCAL_EMBEDDING_TIMEOUT=30

# Business-term semantic retrieval (enabled by default, only used by the bounded LLM
# arbitration, fails open to the deterministic candidates). Set to false to disable.
# It uses the provider above unless a resolver-specific backend or model is set.
RESOLVER_SEMANTIC_RETRIEVAL_ENABLED=true
RESOLVER_SEMANTIC_EMBEDDING_BACKEND=
RESOLVER_SEMANTIC_EMBEDDING_MODEL=

# ── 6. Reranking & Retrieval ─────────────────────────────────────────────────
USE_RERANKER=false
VECTOR_SIMILARITY_FLOOR=0.20

# ── 7. Chemins du Corpus Odoo & Documents ─────────────────────────────────────
# Les chemins des addons sont lus dans addons_path de odoo.conf (ODOO_CONF_PATH ci-dessous).
# Les trois lignes suivantes sont des SURCHARGES OPTIONNELLES (laisser vide en production) :
# CORE_ADDONS_PATH=../odoo-17.0/addons
# CUSTOM_ADDONS_PATH=./odoo_addons
# CORE_FRAMEWORK_ADDONS_PATH=../odoo-17.0/odoo/addons
OCA_SAMPLE_ADDONS_PATH=./tests/oca_sample
EVAL_ODOO_BIN=../odoo-17.0/odoo-bin
EVAL_ODOO_PYTHON=
EVAL_ODOO_CONF=
# Actual configuration used by the target Odoo server; controls addon precedence.
ODOO_CONF_PATH=
EVAL_DB_PREFIX=eval_
EVAL_INSTANCES_DIR=./captures/eval_instances
RAG_DOCS_PATH=./document_rag/documents
# Base vectorielle ChromaDB ; vide = document_rag/vectorstore/chroma_db.
CHROMA_PATH=
DOCUMENT_MAX_TOKENS=2048
GRAPH_CACHE_PATH=./active_graph.json
# Langues chargees dans le graphe en plus des langues actives de l'instance Odoo (codes separes par des virgules)
GRAPH_TRANSLATION_LANGUAGES=en_US,fr_FR
SEMANTIC_INDEX_CACHE_DIR=./active_semantic_index
# Cache de l'index dense de l'experience E1 (evaluation) ; vide = sous SEMANTIC_INDEX_CACHE_DIR.
E1_DENSE_INDEX_CACHE_DIR=

# ── 8. Connexion Instance Odoo (Runtime XML-RPC) ──────────────────────────────
# Laisser ODOO_URL et ODOO_DB vides : ils sont lus dans odoo.conf (http_port, db_name) ; surcharge optionnelle.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=admin
# Mot de passe du compte de service Odoo : OBLIGATOIRE, sans valeur par defaut. Jamais dans l'interface Odoo.
ODOO_ADMIN_PASSWORD=
# Liste de modeles autorises (virgules) ou * pour tout nom de modele valide ; vide = liste par defaut du connecteur.
ODOO_ALLOWED_MODELS=
ORM_RUNTIME_MAX_ROWS=100
ORM_NAME_SEARCH_LIMIT=20
# true = outils ORM typés (P9) ; false = outils métier historiques (ventes/stocks/...)
ORM_USE_TYPED_RUNTIME=true
# Identifiants de societes utilises pour interpreter « meme societe » / « societe differente » dans une question.
ODOO_PRIMARY_COMPANY_ID=1
ODOO_SECONDARY_COMPANY_ID=2

# ── 9. Vérification déterministe des réponses ─────────────────────────────────
# off : désactivée ; report : mesure sans modifier la réponse ; enforce : retire les affirmations non soutenues.
ANSWER_VERIFIER_MODE=report

# ── 10. Budget d'investigation du moteur de code ───────────────────
# Nombre maximal d'appels d'outils par question (defaut du code : 20, code_intelligence/agent/context.py).
CI_MAX_HOPS=20
# Delai maximal (secondes) d'une analyse Semgrep ; augmenter sur une machine chargee.
SEMGREP_TIMEOUT_SECONDS=120
