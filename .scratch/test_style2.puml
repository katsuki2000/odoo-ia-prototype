@startuml
!pragma layout smetana
hide circle
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultFontSize 12

skinparam class {
    BorderColor #F87171
    BackgroundColor #FEF2F2
    HeaderBackgroundColor #FEF2F2
    FontColor #000000
    ArrowColor #4B5563
}

class DocumentSource {
    + id: UUID
    + typeSource: str
    + cheminOrigine: str
    + dateIndexation: datetime
    --
    + extraireContenu()
    + estIndexable()
}

class IndexVectoriel {
    + collectionId: str
    + nombreChunks: int
    + derniereMiseAJour: datetime
    --
    + ajouterChunk(c: ChunkTexte)
    + reindexerDocument(d: DocumentSource)
}

DocumentSource "1..*" -- "0..*" IndexVectoriel
@enduml
