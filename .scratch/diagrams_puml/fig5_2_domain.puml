@startuml
!pragma layout smetana
hide circle
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultFontSize 11
skinparam roundCorner 4
skinparam ArrowColor #4B5563
skinparam ArrowFontColor #374151
skinparam ArrowFontSize 10

skinparam class {
    BorderColor #F87171
    BackgroundColor #FEF2F2
    HeaderBackgroundColor #FEE2E2
    FontColor #1F2937
    FontSize 11
}

skinparam usecase {
    BorderColor #F87171
    BackgroundColor #FEF2F2
    FontColor #1F2937
    FontSize 11
}

skinparam actor {
    BorderColor #EF4444
    BackgroundColor #FEE2E2
    FontColor #1F2937
}

skinparam package {
    BorderColor #F87171
    BackgroundColor #FFF5F5
    FontColor #1F2937
    FontSize 12
}

skinparam node {
    BorderColor #F87171
    BackgroundColor #FFF5F5
    FontColor #1F2937
}

skinparam component {
    BorderColor #F87171
    BackgroundColor #FEF2F2
    FontColor #1F2937
}

class Utilisateur {
    + id: int
    + login: str
    + name: str
    + is_admin: bool
}

class Societe {
    + id: int
    + name: str
}

class ParametresMiroAI {
    + api_url: str
    + api_token: str
    + request_timeout: int
    + activer_ventes: bool
    + activer_stocks: bool
    + activer_comptabilite: bool
}

class JournalAudit {
    + question: str
    + answer: str
    + session_id: str
    + response_time_ms: int
    + sources_text: JSON
    + metadata_text: JSON
    + state: str
}

class SessionConversation {
    + session_id: str
    + date_creation: datetime
    + source_mode: str
}

class Message {
    + role: str
    + contenu: str
    + date_envoi: datetime
}

class SourceDocumentaire {
    + source: str
    + title: str
    + doc_type: str
    + snippet: str
    + score_pertinence: float
}

class ObservationORM {
    + modele: str
    + methode: str
    + enregistrements: list
    + uid_executant: int
}

class PreuveVerification {
    + source_type: str
    + statut: str
    + niveau_confiance: str
}

Utilisateur "1..*" -- "1..*" Societe : rattaché à >
Utilisateur "1" -- "0..*" SessionConversation : ouvre >
SessionConversation "1" *-- "1..*" Message : contient >

Message "0..1" -- "0..*" SourceDocumentaire : cite >
Message "0..1" -- "0..*" ObservationORM : s'appuie sur >
Message "1" -- "1" PreuveVerification : évalué par >

Utilisateur "1" -- "0..*" JournalAudit : trace >
Societe "1" -- "0..*" JournalAudit : cloisonne >
ParametresMiroAI "1" -- "1" Societe : configure >

@enduml
