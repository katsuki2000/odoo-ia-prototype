# Copier en .env (ignore par git). Le .env ne contient QUE des secrets et des adresses de connexion ;
# tout le reste est dans config/settings.py (valeurs par defaut) et se surcharge, si besoin, par une
# variable d'environnement de meme nom (voir les surcharges optionnelles en bas de ce fichier).

# ── Secrets ───────────────────────────────────────────────────────────────────
# Secret de signature JWT (obligatoire, >= 32 octets). Doit etre identique au
# champ api_token des parametres MIRO AI dans Odoo. Generer par exemple :
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Mot de passe du compte de service Odoo : OBLIGATOIRE, sans valeur par defaut. Jamais dans l'interface Odoo.
ODOO_ADMIN_PASSWORD=
# Cle d'API du serveur d'inference, seulement s'il en exige une (Ollama : aucune).
# AWS_LLM_API_KEY=
# AWS_EMBEDDING_API_KEY=

# ── Serveur LLM / embeddings : cible et adresse ───────────────────────────────
# LLM_TARGET choisit l'hote d'inference : aws (defaut, production) ou kaggle (dev temporaire).
# Chaque variable est lue d'abord avec le prefixe de la cible (AWS_ / KAGGLE_), puis sans prefixe.
# Sans rien configurer, la cible aws vise Ollama sur la meme machine (localhost:11434).
# AWS_OLLAMA_HOST=http://<adresse-de-l-instance-aws>:11434

# Kaggle (temporaire) : pour le retirer, supprimer ce bloc et l'entree 'kaggle' de LLM_TARGETS
# dans config/settings.py.
# LLM_TARGET=kaggle
# KAGGLE_OLLAMA_HOST=https://<tunnel-ngrok>

# ── Surcharges optionnelles (non confidentielles ; defauts dans config/settings.py) ──
# Bind HTTP de l'API. Defaut : 127.0.0.1. Mettre 0.0.0.0 seulement en conteneur ou derriere un
# reverse-proxy de confiance.
# API_HOST=127.0.0.1
# Origines CORS autorisees (CSV). Vide = aucune origine navigateur (defaut). Les addons Odoo
# appellent l'API cote serveur ; laisser vide sauf besoin UI.
# CORS_ALLOWED_ORIGINS=
# Modele LLM / embeddings (defaut : qwen3:14b / bge-m3:latest ; garder le meme modele d'embeddings
# entre cibles, l'index semantique n'est valide que pour le modele qui l'a construit) :
# OLLAMA_MODEL=qwen3:14b
# LOCAL_EMBEDDING_MODEL=bge-m3:latest
# Autres reglages (chemins, budgets, limites ORM, Google Drive...) : config/settings.py et
# config/google_drive.py ; table des variables dans le README.
