# Copier en .env (ignore par git). Le .env ne contient QUE ce qui change d'un poste ou d'un deploiement a l'autre :
# secrets, adresses de connexion, emplacements des installations Odoo (defaut portable) ;
# tout le reste est une constante de config/settings.py (ou config/google_drive.py).

# ── Secrets ───────────────────────────────────────────────────────────────────
# Secret de signature JWT (obligatoire, >= 32 octets). Doit etre identique au
# champ api_token des parametres MIRO AI dans Odoo. Generer par exemple :
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Mot de passe du compte de service Odoo : OBLIGATOIRE, sans valeur par defaut. Jamais dans l'interface Odoo.
ODOO_ADMIN_PASSWORD=
# Cle d'API du serveur d'inference, seulement s'il en exige une (Ollama : aucune).
# AWS_LLM_API_KEY=
# AWS_EMBEDDING_API_KEY=
# Identite de test du banc scripts/run_agent_variants_bench.py (outils ORM sous les droits de cet utilisateur) :
# uid d'un utilisateur Odoo NON admin et sa cle API (Preferences, Securite du compte, Nouvelle cle API).
# BENCH_ODOO_UID=
# BENCH_ODOO_API_KEY=
# BENCH_ODOO_COMPANY_ID=

# ── Serveur LLM / embeddings : cible et adresse ───────────────────────────────
# LLM_TARGET choisit l'hote d'inference : aws (defaut, production) ou kaggle (dev temporaire).
# Chaque variable est lue avec le prefixe de la cible (AWS_ / KAGGLE_), sans repli ni serveur implicite.
OLLAMA_HOST=http://<adresse-de-l-instance-aws>:11434

# Kaggle (temporaire) : pour le retirer, supprimer ce bloc et l'entree 'kaggle' de LLM_TARGETS
# dans config/settings.py.
# LLM_TARGET=kaggle
# KAGGLE_OLLAMA_HOST=https://<tunnel-ngrok>

# ── Adresses optionnelles (defauts dans config/settings.py) ───────────────────
# Bind HTTP de l'API. Defaut : 127.0.0.1. Mettre 0.0.0.0 seulement en conteneur ou derriere un
# reverse-proxy de confiance.
# API_HOST=127.0.0.1
# Origines CORS autorisees (CSV). Vide = aucune origine navigateur (defaut). Les addons Odoo
# appellent l'API cote serveur ; laisser vide sauf besoin UI.
# CORS_ALLOWED_ORIGINS=
# Modeles, chemins, budgets, limites ORM, limites Google Drive : constantes de config/settings.py et
# config/google_drive.py (table des variables dans le README).
# Google Drive : corpus partage du RAG (voir document_rag/google_drive_usage.md)
# GOOGLE_DRIVE_FOLDER_IDS=
# GOOGLE_APPLICATION_CREDENTIALS=secrets/miro-drive-reader.json
# GOOGLE_DRIVE_APPROVED_FOR_RAG=false
